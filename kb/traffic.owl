<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="http://example.org/traffic-sma.owl"
         xmlns="http://example.org/traffic-sma.owl#">

<owl:Ontology rdf:about="http://example.org/traffic-sma.owl"/>

<owl:ObjectProperty rdf:about="#belongs_to">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Phase"/>
  <rdfs:range rdf:resource="#Intersection"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#affects_phase">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Event"/>
  <rdfs:range rdf:resource="#Phase"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#plan_for">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#LightPlan"/>
  <rdfs:range rdf:resource="#Intersection"/>
</owl:ObjectProperty>

<owl:DatatypeProperty rdf:about="#direction">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Phase"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#has_bus_lane">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Phase"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#has_weight">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Phase"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#start_s">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Event"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#end_s">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Event"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#arrival_factor">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Event"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#vehicle_kind">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#PriorityRule"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#priority_level">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#PriorityRule"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#action">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#PriorityRule"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#weight_factor">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#PriorityRule"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#green_avenue">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#LightPlan"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#green_side">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#LightPlan"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#cycle_s">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#NetworkRules"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#lost_time_s">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#NetworkRules"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#min_green_s">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#NetworkRules"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
</owl:DatatypeProperty>

<owl:Class rdf:about="#Intersection">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Phase">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Vehicle">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#EmergencyVehicle">
  <rdfs:subClassOf rdf:resource="#Vehicle"/>
</owl:Class>

<owl:Class rdf:about="#Bus">
  <rdfs:subClassOf rdf:resource="#Vehicle"/>
</owl:Class>

<owl:Class rdf:about="#Event">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#SchoolExit">
  <rdfs:subClassOf rdf:resource="#Event"/>
</owl:Class>

<owl:Class rdf:about="#Match">
  <rdfs:subClassOf rdf:resource="#Event"/>
</owl:Class>

<owl:Class rdf:about="#RushHour">
  <rdfs:subClassOf rdf:resource="#Event"/>
</owl:Class>

<owl:Class rdf:about="#PriorityRule">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#LightPlan">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#NetworkRules">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:NamedIndividual rdf:about="#carrefour1">
  <rdf:type rdf:resource="#Intersection"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#carrefour1_avenue">
  <rdf:type rdf:resource="#Phase"/>
  <belongs_to rdf:resource="#carrefour1"/>
  <direction rdf:datatype="http://www.w3.org/2001/XMLSchema#string">avenue</direction>
  <has_bus_lane rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</has_bus_lane>
  <has_weight rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1.0</has_weight>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#carrefour1_side">
  <rdf:type rdf:resource="#Phase"/>
  <belongs_to rdf:resource="#carrefour1"/>
  <direction rdf:datatype="http://www.w3.org/2001/XMLSchema#string">side</direction>
  <has_bus_lane rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</has_bus_lane>
  <has_weight rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1.0</has_weight>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#plan_carrefour1">
  <rdf:type rdf:resource="#LightPlan"/>
  <plan_for rdf:resource="#carrefour1"/>
  <green_avenue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">50</green_avenue>
  <green_side rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">30</green_side>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#carrefour2">
  <rdf:type rdf:resource="#Intersection"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#carrefour2_avenue">
  <rdf:type rdf:resource="#Phase"/>
  <belongs_to rdf:resource="#carrefour2"/>
  <direction rdf:datatype="http://www.w3.org/2001/XMLSchema#string">avenue</direction>
  <has_bus_lane rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</has_bus_lane>
  <has_weight rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1.0</has_weight>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#carrefour2_side">
  <rdf:type rdf:resource="#Phase"/>
  <belongs_to rdf:resource="#carrefour2"/>
  <direction rdf:datatype="http://www.w3.org/2001/XMLSchema#string">side</direction>
  <has_bus_lane rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</has_bus_lane>
  <has_weight rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1.5</has_weight>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#plan_carrefour2">
  <rdf:type rdf:resource="#LightPlan"/>
  <plan_for rdf:resource="#carrefour2"/>
  <green_avenue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">50</green_avenue>
  <green_side rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">30</green_side>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#carrefour3">
  <rdf:type rdf:resource="#Intersection"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#carrefour3_avenue">
  <rdf:type rdf:resource="#Phase"/>
  <belongs_to rdf:resource="#carrefour3"/>
  <direction rdf:datatype="http://www.w3.org/2001/XMLSchema#string">avenue</direction>
  <has_bus_lane rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</has_bus_lane>
  <has_weight rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1.0</has_weight>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#carrefour3_side">
  <rdf:type rdf:resource="#Phase"/>
  <belongs_to rdf:resource="#carrefour3"/>
  <direction rdf:datatype="http://www.w3.org/2001/XMLSchema#string">side</direction>
  <has_bus_lane rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</has_bus_lane>
  <has_weight rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1.0</has_weight>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#plan_carrefour3">
  <rdf:type rdf:resource="#LightPlan"/>
  <plan_for rdf:resource="#carrefour3"/>
  <green_avenue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">50</green_avenue>
  <green_side rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">30</green_side>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#school_exit_c2">
  <rdf:type rdf:resource="#SchoolExit"/>
  <affects_phase rdf:resource="#carrefour2_side"/>
  <start_s rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1800</start_s>
  <end_s rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2400</end_s>
  <arrival_factor rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2.0</arrival_factor>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#match_c1">
  <rdf:type rdf:resource="#Match"/>
  <affects_phase rdf:resource="#carrefour1_avenue"/>
  <start_s rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2700</start_s>
  <end_s rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3300</end_s>
  <arrival_factor rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1.5</arrival_factor>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#rush_c3">
  <rdf:type rdf:resource="#RushHour"/>
  <affects_phase rdf:resource="#carrefour3_avenue"/>
  <start_s rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">600</start_s>
  <end_s rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1500</end_s>
  <arrival_factor rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1.3</arrival_factor>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#rule_emergency">
  <rdf:type rdf:resource="#PriorityRule"/>
  <vehicle_kind rdf:datatype="http://www.w3.org/2001/XMLSchema#string">emergency</vehicle_kind>
  <priority_level rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</priority_level>
  <action rdf:datatype="http://www.w3.org/2001/XMLSchema#string">preempt</action>
  <weight_factor rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1.0</weight_factor>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#rule_bus">
  <rdf:type rdf:resource="#PriorityRule"/>
  <vehicle_kind rdf:datatype="http://www.w3.org/2001/XMLSchema#string">bus</vehicle_kind>
  <priority_level rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</priority_level>
  <action rdf:datatype="http://www.w3.org/2001/XMLSchema#string">boost_weight</action>
  <weight_factor rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1.5</weight_factor>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#network_rules">
  <rdf:type rdf:resource="#NetworkRules"/>
  <cycle_s rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">90</cycle_s>
  <lost_time_s rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10</lost_time_s>
  <min_green_s rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10</min_green_s>
</owl:NamedIndividual>


</rdf:RDF>
